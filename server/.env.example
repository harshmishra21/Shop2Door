# Shop2Door backend configuration
# Copy to .env (same folder) and fill in to use a real database.
# If ANY of the AZURE_SQL_* values are missing — or the connection fails —
# the server automatically runs in SEED mode and serves built-in dummy data
# from the backend, so the app works out of the box with zero setup.

PORT=3000

# Azure SQL Database (e.g. myserver.database.windows.net)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=shop2door
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
